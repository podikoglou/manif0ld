# Bluesky Jetstream
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Cloudflare AI Gateway / Workers AI
# CF_AI_GATEWAY_URL is the gateway base URL ending in the account ID.
CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/{account_id}
CF_AI_GATEWAY_ID=manif0ld
# API key used as the Bearer token for Workers AI requests.
CF_API_KEY=...
TRIAGE_MODEL=@cf/google/gemini-3.5-flash-lite
ONBOARDING_MODEL=@cf/deepseek/deepseek-v4.1-flash-1017

# Manifold
MANIFOLD_API_KEY=...
# The bot user ID is fetched from GET /v0/me at startup.

# Discord
DISCORD_BOT_TOKEN=...
DISCORD_GUILD_ID=...
DISCORD_CONTROL_CHANNEL_ID=...
DISCORD_OPERATOR_USER_ID=...

# Trading (defaults, overridable per market via /track)
DEFAULT_MARKET_BUDGET=100
KELLY_FRACTION=0.25
ENTRY_EDGE_THRESHOLD=0.05
EXIT_EDGE_THRESHOLD=0.01
MIN_TRADE_SIZE=1.0

# Belief engine
BELIEF_KAPPA=1.1
BELIEF_HALFLIFE_HOURS=4.0

# Storage
DB_PATH=./data/arb.db
