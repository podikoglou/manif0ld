# Bluesky Jetstream
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Cloudflare AI Gateway / Workers AI (read by the rig cloudflare provider)
# CLOUDFLARE_ACCOUNT_ID goes into the endpoint URL
# .../accounts/{account_id}/ai/v1/chat/completions; a placeholder fails at startup.
CLOUDFLARE_ACCOUNT_ID={account_id}
CLOUDFLARE_AI_GATEWAY_ID=manif0ld
# API token used as the Authorization Bearer for AI Gateway requests.
CLOUDFLARE_API_TOKEN=...

# OpenRouter (read by the rig openrouter provider when models use openrouter/ prefix)
# The same key also serves the decisions endpoint when triage uses the
# openrouter-decisions/ prefix.
# OPENROUTER_API_KEY=...

# Triage must use a decision model; onboarding must use a chat model that can
# call tools (the research agent calls `web_search`, `read_page`, and
# `submit_sieve`).
TRIAGE_MODEL=openrouter-decisions/baseten/joey-1
ONBOARDING_MODEL=cloudflare/@cf/deepseek/deepseek-v4.1-flash-1017

# Firecrawl (web research for the onboarding agent)
FIRECRAWL_API_KEY=fc-...

# Manifold
MANIFOLD_API_KEY=...
# The bot user ID is fetched from GET /v0/me at startup.

# Discord
DISCORD_BOT_TOKEN=...
DISCORD_GUILD_ID=...
DISCORD_CONTROL_CHANNEL_ID=...
DISCORD_OPERATOR_USER_ID=...

# Trading (defaults, overridable per market via /track)
DEFAULT_MARKET_BUDGET=100
KELLY_FRACTION=0.25
ENTRY_EDGE_THRESHOLD=0.05
EXIT_EDGE_THRESHOLD=0.01
MIN_TRADE_SIZE=1.0
# Slack allowed beyond the bot's own fair price in one buy's fill limit
# (docs/ALGO.md §S1): the sweep limit becomes p_internal − ε, so the bot
# never fills worse than its believed fair price. Kept in the open interval
# (0, 0.05) — see src/config.rs.
LIMIT_EPSILON=0.01
# Lifetime of the resting remainder of a fair-capped buy (seconds), sent as
# expiresMillisAfter on every bot buy: one POST consumes opposing resting
# orders at their price, sweeps the AMM to the cap, and rests what is left.
# The rest either fills passively or expires (bounded into [1, 300]).
LIMIT_EXPIRY_SECS=60
# Reverse-drift cancel slack (docs/SPEC.md §6.6): an own resting order is
# cancelled once its limit price sits this far past the fresh fair-capped
# cap, on the outcome it buys. In the open interval (0, 1).
LIMIT_DRIFT_CANCEL=0.05

# Multiple-choice trading
# Dry run sends every planned bet with `dryRun: true` and persists nothing.
# Keep it true until the canary phase is approved.
TRADING_DRY_RUN=true
# Maximum answers of one market that may hold shares at the same time.
MC_MAX_POSITIONS=6
# Maximum new answer entries in one evaluation.
MC_MAX_NEW_PER_TICK=2
# Maximum share of a market's budget committed to a single answer.
MC_MAX_ANSWER_FRACTION=0.25

# Manifold REST budget: one global token bucket shares every request, filled
# at this rate and refilled continuously; trade writes win over housekeeping.
RATE_LIMIT_PER_MIN=500

# S2 new-market sniping (docs/ALGO.md §S2)
# Master switch; snipe markets are never discovered while this is false.
SNIPE_ENABLED=false
# Separate global mana pool for snipes, so autonomous discovery cannot spend
# the per-market budgets that /track allocated.
SNIPE_POOL_MANA=100
# Maximum mana for one snipe; must be <= SNIPE_POOL_MANA (larger values are
# warned about at startup and clamped to the remaining pool at use time).
SNIPE_MAX_MANA=10
# Minimum market liquidity required to absorb a snipe.
SNIPE_MIN_LIQ=100
# Minimum |p_model - p_initial| worth trading, in the open interval (0, 1).
SNIPE_MIN_GAP=0.10
# Fractional Kelly for snipe sizing, in (0, 1]; small because each snipe is
# one model shot on a thin market.
SNIPE_KELLY_FRACTION=0.25
# How long a new market stays eligible for a snipe, in seconds (>= 1); the
# strategy owns the boundary check.
SNIPE_TTL_SECS=3600
# Deadline for one fair-probability decision call, in [1, 30] seconds.
SNIPE_DECISION_TIMEOUT_SECS=2

# S3 smart-money leaderboard (docs/ALGO.md §3/S3, docs/SPEC.md §6.10)
# The leaderboard is read-only, so it is on by default; copy execution will
# have its own flag.
TRADERS_ENABLED=true
# Target size of the scored watch list, in [10, 1000] traders.
TRADER_WATCH_SIZE=200
# Minimum sampled bet count before a trader can hold a watch-list slot; this
# suppresses accounts that made one lucky bet.
TRADER_MIN_BETS=25
# Minutes between refreshes, in [5, 1440]. Trader skill is a slow signal.
TRADER_REFRESH_MIN=60
# Hard cap on Manifold requests one refresh may spend (>= 20). One refresh
# costs three universe requests plus two per enriched trader, so the default
# covers ~58 traders and the rest of the list keeps its last score; raise it
# to refresh the whole watch list in one pass.
TRADER_REQUEST_BUDGET=120

# Belief engine
BELIEF_KAPPA=1.1
BELIEF_HALFLIFE_HOURS=4.0
# Probability of evidence a post must reach before it moves belief.
TRIAGE_MIN_EVIDENCE=0.7

# Storage
DB_PATH=./data/manif0ld.db
