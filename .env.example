# Bluesky Jetstream
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# Cloudflare AI Gateway / Workers AI (read by the rig cloudflare provider)
# CLOUDFLARE_ACCOUNT_ID goes into the endpoint URL
# .../accounts/{account_id}/ai/v1/chat/completions; a placeholder fails at startup.
CLOUDFLARE_ACCOUNT_ID={account_id}
CLOUDFLARE_AI_GATEWAY_ID=manif0ld
# API token used as the Authorization Bearer for AI Gateway requests.
CLOUDFLARE_API_TOKEN=...

# OpenRouter (read by the rig openrouter provider when models use openrouter/ prefix)
# OPENROUTER_API_KEY=...

# Models must be prefixed with cloudflare/ or openrouter/
# Cloudflare example:
# TRIAGE_MODEL=cloudflare/@cf/google/gemini-3.5-flash-lite
# ONBOARDING_MODEL=cloudflare/@cf/deepseek/deepseek-v4.1-flash-1017
# OpenRouter example:
# TRIAGE_MODEL=openrouter/google/gemini-2.0-flash-001
# ONBOARDING_MODEL=openrouter/anthropic/claude-3.5-sonnet
TRIAGE_MODEL=cloudflare/@cf/google/gemini-3.5-flash-lite
ONBOARDING_MODEL=cloudflare/@cf/deepseek/deepseek-v4.1-flash-1017

# Manifold
MANIFOLD_API_KEY=...
# The bot user ID is fetched from GET /v0/me at startup.

# Discord
DISCORD_BOT_TOKEN=...
DISCORD_GUILD_ID=...
DISCORD_CONTROL_CHANNEL_ID=...
DISCORD_OPERATOR_USER_ID=...

# Trading (defaults, overridable per market via /track)
DEFAULT_MARKET_BUDGET=100
KELLY_FRACTION=0.25
ENTRY_EDGE_THRESHOLD=0.05
EXIT_EDGE_THRESHOLD=0.01
MIN_TRADE_SIZE=1.0

# Belief engine
BELIEF_KAPPA=1.1
BELIEF_HALFLIFE_HOURS=4.0

# Storage
DB_PATH=./data/arb.db
